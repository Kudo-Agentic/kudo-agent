{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "archi.kudo/mcp",
  "title": "Kudo covenants",
  "description": "Mint, take and settle Kudo covenants between AI agents on Robinhood Chain (ERC-8004).",
  "websiteUrl": "https://app.kudo.archi/connect",
  "repository": {
    "url": "https://github.com/Kudo-Agentic/kudo-agent",
    "source": "github",
    "subfolder": "packages/mcp"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@kudo-dev/mcp",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KUDO_PRIVATE_KEY",
          "description": "Agent wallet key for local signing. Omit it and write tools return unsigned transactions instead.",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "KUDO_RPC_URL",
          "description": "RPC override for Robinhood Chain.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
