# Environment for an agent started with startAgent (@kudo-dev/sdk/agent).
# Copy to your agent's folder as .env and fill in. Never commit it.
#
# Who the agent is (its system prompt, extra skills and jobs) is code, passed
# to startAgent. Only secrets and per-deployment values live here.

ANTHROPIC_API_KEY=

# This agent's signing key. In this PoC it sits in the environment, which
# means anything that can run a shell in this container can read it —
# including the agent itself. Covenant asks are written by counterparties, so
# treat on-chain text as untrusted input.
PRIVATE_KEY=

# Or derive the key inside a Phala TEE instead: KUDO_KEY_SOURCE=dstack. Then
# PRIVATE_KEY is ignored, the key never exists outside the enclave, and it is
# the same on every restart of the same app. Needs /var/run/dstack.sock mounted.
KUDO_KEY_SOURCE=

# With this set, POST /message needs `Authorization: Bearer <CHAT_TOKEN>`.
# Every message is a paid model run; set it for any agent on the public internet.
CHAT_TOKEN=

# The name this agent registers on-chain. Its ERC-8004 id needs no setting:
# at startup the runtime finds the identity this wallet registered, and a new
# agent registers one at its first run.
AGENT_NAME=
# Where this agent is reachable, registered as ERC-8004 `endpoint` metadata.
AGENT_ENDPOINT=

# --- Robinhood Chain mainnet (chainId 4663) ---
# The live deployment, and the only one the skills support. USDG here is real
# money, so start with a throwaway wallet and small amounts.
RPC_URL=https://rpc.mainnet.chain.robinhood.com
KUDO=0x1930D0FEaB14b024353bF22adE03Db989aD640C7
IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432

# --- Gas sponsorship ---
# The relay that pays this agent's gas while sponsorship runs. Every write tries
# it first and falls back to a plain transaction (paid in ETH) only when nothing
# was sent. Empty means Kudo's relay,
# https://app.kudo.archi/api/sponsor; "off" means always pay your own gas.
KUDO_SPONSOR_URL=

# --- Settlement token ---
# USDG is an ERC-20 with six decimals, so 1 USDG is 1000000 base units (5 USDG
# is 5000000; never cast to-wei). ETH is for gas only and is never what a
# promise is denominated in.
USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# --- Schedule overrides (optional) ---
# The agent's own `jobs` (passed to startAgent) apply unless one of these is set.
#   JOBS                    <job>:<seconds>, comma separated, minimum ten seconds.
#                           A job the agent defines keeps its own prompt; any
#                           other name runs the bundled prompt of that name.
#   TICK_INTERVAL_SECONDS   0 runs no jobs: something else owns this agent's work
# Jobs share one key, so only one run happens at a time — a run that comes due
# while another is going waits rather than colliding on the nonce.
JOBS=
TICK_INTERVAL_SECONDS=

# --- Logging ---
# Every run logs what started it, each command the agent runs, the output of
# any that fails, and how it ended (turns, cost, errors). debug also logs every
# command's output and what the agent said. Secrets are redacted either way.
LOG_LEVEL=info

# --- Phala TEE ---
# The app id is read at startup from the dstack socket, so leave this blank on
# Phala. Set it by hand only to exercise the code path locally, where it is
# reported as unattested and never written on-chain.
TEE_ID=

# --- X / Twitter ---
# All four are required. If any is missing the request goes out unsigned and X
# answers 403 "Authenticating with Unknown", which reads like a permissions
# problem but is not.
#
# The access token must be read-write. Setting the app to "Read and write" in
# the developer portal is not enough — regenerate the access token and secret
# afterwards, or the old token keeps its read-only permission.
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
TWITTER_HANDLE=

# --- Older deployments: not supported ---
# These are earlier Kudo contract versions with a different status enum. The
# skills and prompts no longer describe them; do not point KUDO at either.
#   mainnet legacy:  KUDO=0xc269c6176f3418A84FCdA5911723B0d358971351
#   testnet (46630): RPC_URL=https://rpc.testnet.chain.robinhood.com
#                    KUDO=0x7021279517a7b301b8d10eD9c3b9F73C101146f1
#                    IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
#                    USDG=0xc44DB72f7d3185b6AAA7907434592EB7689D0100 (mock)
