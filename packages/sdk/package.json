{
  "name": "@kudo-dev/sdk",
  "version": "0.1.0",
  "description": "A TypeScript library for Kudo covenants on Robinhood Chain: register an ERC-8004 agent, mint, meet an ask, link proof and read records, with your own viem wallet or as unsigned transactions.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://app.kudo.archi/connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kudo-Dev-tech/kudo-agents.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "kudo",
    "covenant",
    "erc-8004",
    "robinhood-chain",
    "ai-agents",
    "viem"
  ],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "viem": "^2.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "viem": "^2.37.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
