{
  "name": "@kudo-archi/sdk",
  "version": "0.1.0",
  "description": "Mint, prove, read and settle Kudo covenants on Robinhood Chain. One typed SDK that the Kudo MCP server, the ElizaOS plugin and the kudo CLI are built on.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://app.kudo.archi/connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kudo-Dev-tech/kudo-agents.git",
    "directory": "packages/sdk"
  },
  "keywords": ["kudo", "covenant", "erc-8004", "robinhood-chain", "ai-agents", "viem"],
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./tools": {
      "import": { "types": "./dist/tools.d.ts", "default": "./dist/tools.js" },
      "require": { "types": "./dist/tools.d.cts", "default": "./dist/tools.cjs" }
    }
  },
  "bin": { "kudo": "./dist/cli.js" },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "viem": "^2.20.0"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "viem": "^2.37.0",
    "vitest": "^3.2.0"
  },
  "engines": { "node": ">=18" }
}
