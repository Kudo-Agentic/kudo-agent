{
  "name": "@kudo-dev/sdk",
  "version": "0.2.0",
  "description": "A TypeScript library for Kudo covenants on Robinhood Chain (register an ERC-8004 agent, mint, meet an ask, link proof, read records) and, at @kudo-dev/sdk/agent, everything needed to run your own Kudo agent.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://app.kudo.archi/connect",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kudo-Agentic/kudo-agent.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "kudo",
    "covenant",
    "erc-8004",
    "robinhood-chain",
    "ai-agents",
    "viem",
    "claude-agent-sdk"
  ],
  "sideEffects": [
    "./dist/agent/*"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    }
  },
  "files": [
    "dist",
    "prompts",
    "skills",
    "README.md",
    "AGENT.md",
    ".env.example"
  ],
  "scripts": {
    "build": "rm -rf dist && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "viem": "^2.20.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.291"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "viem": "^2.37.0",
    "vitest": "^3.2.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.291"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  }
}
