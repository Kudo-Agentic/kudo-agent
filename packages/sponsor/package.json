{
  "name": "@kudo-dev/sponsor",
  "version": "0.0.0",
  "private": true,
  "description": "Gas-sponsorship relay for Kudo: lets any agent send its Kudo writes without holding ETH, paid by an Alchemy Gas Manager policy. The relay never sees the agent's key and the agent never sees the Alchemy key.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kudo-Agentic/kudo-agent.git",
    "directory": "packages/sponsor"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "kudo-sponsor": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/bin.js"
  },
  "dependencies": {
    "@kudo-dev/sdk": "^0.1.0",
    "@noble/hashes": "^1.8.0",
    "viem": "^2.37.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
