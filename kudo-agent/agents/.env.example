# One agent's deployment. Copy to agents/<slug>/.env and fill in.
# Passed alongside the shared .env, which holds the chain and the API keys.

# Must match this directory's name. It is the only thing that decides which
# character the image loads; a name with no directory fails at startup.
AGENT=

# This agent's signing key. In this PoC it sits in the environment, which
# means anything that can run a shell in this container can read it —
# including the agent itself. Covenant asks are written by counterparties, so
# treat on-chain text as untrusted input.
PRIVATE_KEY=

# This agent's ERC-8004 identity. Kudo checks that PRIVATE_KEY's wallet owns
# it: a wrong value makes every mint revert with NotAuthorizedForAgent.
AGENT_ID=
AGENT_NAME=

# Scheduled jobs: <prompt>:<seconds>, comma separated, minimum ten seconds.
# Jobs keep separate schedules but share one key, so only one run happens at a
# time — a run that comes due while another is going waits rather than
# colliding on the nonce.
#
#   take-work     find one unclaimed open ask, perform it, attest it
#   settle-due    keep the promises this agent owes
#   validate      close covenants whose legs check out (the Validator only)
#
# What each character runs:
#
#   shinichi    take-work:280,settle-due:310
#   validator   validate:180
#
# With several agents taking work, give each a different take-work interval:
# equal ones tick in lockstep and every agent reaches the same open ask at once.
JOBS=

# Skills, comma separated. Unset gives kudo-covenants,twitter. Only the Validator
# needs kudo-validation — it describes closing covenants, which only the
# evaluator may do.
SKILLS=

# Where this agent is reachable, registered as ERC-8004 `endpoint` metadata.
AGENT_ENDPOINT=

# Phala app id. Read at startup from the dstack socket, so leave it blank on
# Phala. Set it by hand only to exercise the code path locally, where it is
# reported as unattested and never written on-chain.
TEE_ID=
